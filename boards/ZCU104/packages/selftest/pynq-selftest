class _S:
    base = None


def _overlay():
    if _S.base is None:
        from pynq.overlays.base import BaseOverlay
        log.debug("programming PL with %s", OVERLAY_BIT)
        _S.base = BaseOverlay(OVERLAY_BIT)
        log.debug("PL programmed")
    return _S.base


def _free_iop(iop):
    # Clear any program PYNQ recorded against a Pmod IOP so a fresh one can load.
    # The Pmod and MicroblazeLibrary drivers cannot pass force=True, so a second
    # test (or a re-run over a cached overlay) otherwise fails with "already
    # running". iop is an mb_info dict or a MicroblazeHierarchy.
    from pynq import PL
    ip = (iop.mb_info if hasattr(iop, "mb_info") else iop).get("ip_name")
    if ip in PL.mem_dict:
        PL.mem_dict[ip]["state"] = None


def b_pmod_firmware():
    import pynq.lib.pmod as m
    pdir = os.path.dirname(m.__file__)
    _, n = sh("ls %s/pmod_*.bin 2>/dev/null | wc -l" % pdir)
    nbin = int(n) if n.isdigit() else 0
    ok("pmod firmware present (%d .bin in %s)" % (nbin, pdir)) if nbin >= 20 \
        else bad("expected >=20 pmod .bin, found %d" % nbin)
    ok("pmod_oled.bin present") if os.path.isfile("%s/pmod_oled.bin" % pdir) else bad("pmod_oled.bin missing")
    _, ng = sh("ls %s/pmod_grove_*.bin 2>/dev/null | wc -l" % pdir)
    ok("pmod_grove_*.bin present (%s)" % ng) if ng.isdigit() and int(ng) >= 1 else bad("pmod_grove_*.bin missing")


def b_gpio():
    base = _overlay()
    nsw, nbtn, nled = len(base.switches), len(base.buttons), len(base.leds)
    sw = [base.switches[i].read() for i in range(nsw)]
    bt = [base.buttons[i].read() for i in range(nbtn)]
    log.debug("switches=%s buttons=%s leds=%d", sw, bt, nled)
    base.leds[0].on()
    base.leds[0].off()
    if all(v in (0, 1) for v in sw + bt):
        ok("GPIO ok (%d switches=%s, %d buttons=%s, %d LEDs toggled)" % (nsw, sw, nbtn, bt, nled))
    else:
        bad("GPIO returned non-binary values (sw=%s bt=%s)" % (sw, bt))


def b_pmod_oled_grove():
    base = _overlay()
    from pynq.lib.pmod import Pmod_OLED, Grove_TMP, PMOD_GROVE_G4
    log.debug("loading pmod_oled.bin on PMODA + writing text")
    _free_iop(base.PMODA)
    oled = Pmod_OLED(base.PMODA)
    oled.clear()
    oled.write("PYNQ self-test")
    ok("Pmod OLED on PMODA loaded + wrote (verify display by eye)")
    log.debug("reading Grove temperature on PMODB G4")
    _free_iop(base.PMODB)
    tmp = Grove_TMP(base.PMODB, PMOD_GROVE_G4)
    t = tmp.read()
    ok("Grove temperature %.2f C on PMODB G4 (in range)" % t) if 0 < t < 60 \
        else bad("Grove temperature %.2f C out of the expected 0-60 C range" % t)


def b_pmod_microblaze():
    base = _overlay()
    from pynq.lib import MicroblazeLibrary
    log.debug("compiling + booting a MicroBlaze program on the PMODA IOP")
    _free_iop(base.PMODA)
    lib = MicroblazeLibrary(base.PMODA, ["gpio"])
    ran = hasattr(lib, "gpio_open")
    del lib
    ok("PMODA MicroBlaze IOP compiled + ran a program (gpio library)") if ran \
        else bad("MicroblazeLibrary loaded but the gpio API is missing")


def b_hdmi():
    base = _overlay()
    import numpy as np
    from pynq.lib.video import VideoMode, PIXEL_RGB
    W, H, bw = 1280, 720, 1280 // 8
    bars = np.array([[255, 255, 255], [255, 255, 0], [0, 255, 255], [0, 255, 0],
                     [255, 0, 255], [255, 0, 0], [0, 0, 255], [0, 0, 0]], dtype=np.uint8)
    pattern = np.zeros((H, W, 3), np.uint8)
    for i, c in enumerate(bars):
        pattern[:, i * bw:((i + 1) * bw if i < 7 else W)] = c

    def bar_means(img):
        return np.array([img[:, i * bw + bw // 4:i * bw + (3 * bw) // 4].reshape(-1, 3).mean(0) for i in range(8)])

    ho, hi = base.video.hdmi_out, base.video.hdmi_in
    log.debug("asserting Rx HPD")
    try:
        hi.frontend.set_hpd(1)
    except Exception as e:
        log.debug("set_hpd failed: %r", e)
    time.sleep(0.5)
    log.debug("configuring + starting Tx, writing colour bars")
    ho.configure(VideoMode(W, H, 24), PIXEL_RGB)
    ho.start()
    f = ho.newframe()
    f[:] = pattern
    ho.writeframe(f)
    time.sleep(1.5)
    log.debug("configuring + starting Rx, capturing")
    hi.configure(PIXEL_RGB)
    hi.start()
    rx = None
    for _ in range(8):
        rx = np.array(hi.readframe())
    tx_m, rx_m = bar_means(pattern), bar_means(rx)
    mad = min(float(np.abs(tx_m - rx_m).mean()), float(np.abs(tx_m - rx_m[:, ::-1]).mean()))
    distinct = float(np.std(rx_m, axis=0).mean())
    log.debug("MAD=%.1f DISTINCT=%.1f RXMODE=%dx%d", mad, distinct, hi.mode.width, hi.mode.height)
    try:
        ho.close()
        hi.close()
    except Exception:
        pass
    ok("HDMI Tx->Rx loopback recovered the colour bars (MAD=%.1f distinct=%.1f)" % (mad, distinct)) \
        if (mad < 40 and distinct > 40) else \
        bad("HDMI loopback not verified (MAD=%.1f distinct=%.1f; check the Tx->Rx cable)" % (mad, distinct))


def b_webcam():
    if not os.path.exists("/dev/video0"):
        raise Skip("/dev/video0 absent -- plug in a USB webcam")
    out = "/tmp/pynq-selftest-webcam.jpg"
    log.debug("capturing a frame with fswebcam")
    subprocess.run(["fswebcam", "--no-banner", "-d", "/dev/video0", "-r", "640x480", "--save", out],
                   check=True, capture_output=True, timeout=25)
    size = os.path.getsize(out) if os.path.exists(out) else 0
    ok("USB webcam captured a frame (%d bytes)" % size) if size > 0 else bad("USB webcam produced an empty frame")


PYNQ_VENV = "/usr/local/share/pynq-venv"


def preflight():
    errs = []
    if PYNQ_VENV not in sys.executable and PYNQ_VENV not in sys.prefix:
        errs.append("not in the PYNQ venv -- source %s/bin/activate "
                    "(or /etc/profile.d/pynq_venv.sh)" % PYNQ_VENV)
    if not os.environ.get("XILINX_XRT"):
        errs.append("XRT environment not sourced -- source /etc/profile.d/xrt_setup.sh "
                    "(plain `sudo` scrubs it; become root first, then source)")
    if errs:
        print("PRE-FLIGHT FAILED -- fix the environment and re-run:")
        for e in errs:
            print("  - %s" % e)
        sys.exit(2)


# ===========================================================================
def main():
    global _run_hw
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--no-peripherals", action="store_true", help="software-only; skip hardware checks")
    args = ap.parse_args()
    _run_hw = not args.no_peripherals

    preflight()

    bar = "=" * 54
    print(bar)
    print(" PYNQ image self-test  (%s)" % BOARD)
    print(" host: %s   kernel: %s" % (os.uname().nodename, os.uname().release))
    print(" mode: %s" % ("full (peripheral tests enabled)" if _run_hw else "--no-peripherals (software-only)"))
    print(" log: %s" % LOG_FILE)
    print(bar)

    # ---- common checks ----
    run(1,  "Root filesystem auto-resize",             c_resize)
    run(2,  "Networking (global IPv4)",                c_networking)
    run(3,  "CMA pool",                                c_cma)
    run(4,  "Jupyter server",                          c_jupyter)
    run(5,  "XRT runtime",                             c_xrt)
    run(6,  "PYNQ overlay + DMA buffer",               c_overlay_allocate, timeout=90)
    run(7,  "systemd failed units",                    c_systemd_units)
    run(8,  "Image identity (PynqLinux; version read from image)", c_image_identity)
    run(9,  "xilinx user + groups",                    c_user_groups)
    run(10, "Notebook delivery",                       c_notebooks)
    run(11, "Serial console autologin",                c_serial_autologin)
    run(12, "merged-/usr layout",                      c_merged_usr)
    run(13, "base-config patches",                     c_baseconfig)
    run(14, "sysfs GPIO interface",                    c_sysfs_gpio)
    run(15, "pybind11 C++ compile + import",           c_pybind11, timeout=120)
    run(16, "Internet connectivity",                   c_internet, timeout=45)
    run(17, "Overlay download + install (%s)" % OVERLAY_PKG, c_overlay_download, timeout=300)
    run(18, "Dropped libs (arduino/rpi/logictools removed)", c_dropped_libs)
    run(19, "deb-src source availability (apt-get source)", c_deb_src, timeout=40)

    # ---- board-specific checks (ZCU104) ----
    run(20, "Pmod/Grove MicroBlaze firmware installed", b_pmod_firmware)
    run(21, "LEDs / buttons / switches (GPIO)",         b_gpio,            timeout=20, hardware=True)
    run(22, "Pmod OLED + Grove temperature",            b_pmod_oled_grove, timeout=60, hardware=True)
    run(23, "PMODA MicroBlaze IOP (compile + run)",      b_pmod_microblaze, timeout=90, hardware=True)
    run(24, "HDMI Tx->Rx loopback",                     b_hdmi,            timeout=120, hardware=True)
