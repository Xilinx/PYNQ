def c_pybind11():
    import tempfile
    import shutil
    d = tempfile.mkdtemp(prefix="pynq_pb_")
    cwd = os.getcwd()
    try:
        os.chdir(d)
        from pynq.lib.pybind11.proc import Pybind11Processor
        log.debug("compiling a C++ module with pybind11")
        Pybind11Processor("pynq_selftest_pb", {"cflags": None, "ldflags": None},
                          "int add(int a, int b){ return a + b; }\n")
        sys.path.insert(0, d)
        import pynq_selftest_pb
        if pynq_selftest_pb.add(2, 3) == 5:
            ok("pybind11 compiled a C++ module and imported it")
        else:
            bad("pybind11 module returned a wrong result")
    finally:
        os.chdir(cwd)
        shutil.rmtree(d, ignore_errors=True)


def c_internet():
    rc, _ = sh("curl -fsS --max-time 15 -o /dev/null https://github.com "
               "|| wget -q --timeout=15 -O /dev/null https://github.com", timeout=40)
    ok("reached https://github.com (overlay download possible)") if rc == 0 \
        else bad("no internet reachable (overlay download needs DNS/gateway/proxy)")


def c_overlay_download():
    py = sys.executable
    rc, _ = sh("'%s' -m pip install --no-build-isolation --no-input %s >/tmp/ovl-pip.log 2>&1" % (py, OVERLAY_PKG), timeout=180)
    if rc != 0:
        bad("pip install %s failed (see /tmp/ovl-pip.log)" % OVERLAY_PKG)
        return
    ok("pip installed %s" % OVERLAY_PKG)
    sh("rm -rf %s" % OVERLAY_NB_DIR)
    rc, _ = sh("pynq-get-notebooks %s -p %s --force >/tmp/ovl-get.log 2>&1" % (OVERLAY_PKG, OVERLAY_NB_DIR), timeout=180)
    ok("pynq-get-notebooks delivered %s" % OVERLAY_PKG) if rc == 0 \
        else bad("pynq-get-notebooks failed (see /tmp/ovl-get.log)")
    _, bit = sh("find %s /usr/local/share/pynq-venv -name 'resizer.bit' 2>/dev/null | head -1" % OVERLAY_NB_DIR)
    if bit:
        rc, _ = sh("'%s' -c \"from pynq import Overlay; Overlay('%s')\" >/tmp/ovl-load.log 2>&1" % (py, bit), timeout=90)
        ok("downloaded overlay programmed the PL (%s)" % os.path.basename(bit)) if rc == 0 \
            else bad("could not load a downloaded overlay bitstream (see /tmp/ovl-load.log)")
    else:
        bad("no resizer.bit found in the downloaded overlay")


def c_dropped_libs():
