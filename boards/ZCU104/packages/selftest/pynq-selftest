def c_baseconfig():
    sudoers = read_priv("/etc/sudoers")
    if not sudoers:
        skip("/etc/sudoers not readable (needs root or passwordless sudo)")
    else:
        ok("sudoers keeps BOARD env") if 'env_keep="BOARD"' in sudoers else bad("sudoers missing env_keep BOARD")
    checks = [
        (any(l.strip().startswith("ForwardX11 yes") for l in read("/etc/ssh/ssh_config").splitlines()),
         "ssh_config ForwardX11 yes", "ssh_config ForwardX11 not enabled"),
        (os.path.isfile("/etc/pip.conf"), "/etc/pip.conf present", "/etc/pip.conf missing"),
        ("/opt/microblazeel-xilinx-elf/bin" in read("/etc/environment"),
         "PATH includes microblaze toolchain", "microblaze toolchain not on PATH"),
        (os.environ.get("PYNQ_PYTHON") == "python3", "PYNQ_PYTHON=python3", "PYNQ_PYTHON not python3"),
        ("[xilinx]" in read("/etc/samba/smb.conf"), "samba [xilinx] share present", "samba [xilinx] share missing"),
    ]
    for good, okmsg, badmsg in checks:
        ok(okmsg) if good else bad(badmsg)


