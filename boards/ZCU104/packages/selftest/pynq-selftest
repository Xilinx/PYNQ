# PYNQ image self-test. See README.md for the required environment.
#   pynq-selftest [--no-peripherals]

import argparse
import logging
import os
import re
import signal
import subprocess
import sys
import time

# --- board configuration ---------------------------------------------------
BOARD          = "ZCU104"
OVERLAY_BIT    = "base.bit"
OVERLAY_PKG    = "pynq-helloworld"
OVERLAY_NB_DIR = "/tmp/pynq-helloworld-nb"

# --- logging + harness ------------------------------------------------------
LOG_FILE = os.environ.get("PYNQ_TEST_LOG",
                          "/tmp/pynq-selftest.%s.log" % time.strftime("%Y%m%d-%H%M%S"))
log = logging.getLogger("pynq-selftest")
log.setLevel(logging.DEBUG)
_ch = logging.StreamHandler(sys.stdout)
_ch.setFormatter(logging.Formatter("      %(asctime)s %(levelname)-5s %(message)s", "%H:%M:%S"))
log.addHandler(_ch)
try:
    _fh = logging.FileHandler(LOG_FILE)
    _fh.setFormatter(logging.Formatter("%(asctime)s %(levelname)-5s %(message)s", "%H:%M:%S"))
    log.addHandler(_fh)
except OSError:
    pass

_passed = _failed = _skipped = 0
_run_hw = True


class Skip(Exception):
    pass


class Timeout(Exception):
    pass


def _on_alarm(signum, frame):
    raise Timeout()


signal.signal(signal.SIGALRM, _on_alarm)


def ok(msg):
    global _passed
    _passed += 1
    print("  [PASS] %s" % msg)


def bad(msg):
    global _failed
    _failed += 1
    print("  [FAIL] %s" % msg)


def skip(msg):
    global _skipped
    _skipped += 1
    print("  [SKIP] %s" % msg)


def run(num, name, fn, timeout=30, hardware=False):
    print("[%d] %s" % (num, name))
    if hardware and not _run_hw:
        skip("hardware check skipped (--no-peripherals)")
        return
    signal.alarm(timeout)
    try:
        fn()
    except Skip as e:
        skip(str(e))
    except Timeout:
        bad("%s TIMED OUT after %ds -- hang (last log line shows the stalled step)" % (name, timeout))
    except Exception as e:
        bad("%s errored: %r" % (name, e))
    finally:
        signal.alarm(0)
        sys.stdout.flush()


def sh(cmd, timeout=15):
    p = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
    return p.returncode, p.stdout.strip()


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def read_priv(path):
    txt = read(path)
    if txt:
        return txt
    rc, out = sh("sudo -n cat %s 2>/dev/null" % path, timeout=10)
    return out if rc == 0 else ""


