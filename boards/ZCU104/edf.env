# ZCU104 EDF (Yocto) build configuration.
#
# Sourced by sdbuild/scripts/build_edf_boot.sh. Names the Yocto machine
# bitbake targets and selects the build mode.
#
# EDF_MODE=prebuilt -> use a machine config AMD ships in meta-xilinx-bsp.

EDF_MANIFEST_TAG=amd-edf-rel-v25.11.1
EDF_MODE=prebuilt
EDF_BOOT_MACHINE=zynqmp-zcu104-sdt-full
EDF_LINUX_MACHINE=zynqmp-zcu104-sdt-full
