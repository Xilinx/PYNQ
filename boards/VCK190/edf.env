# VCK190 EDF (Yocto) build configuration.
#
# Sourced by sdbuild/scripts/build_edf_boot.sh. Names the Yocto machine
# bitbake targets and selects the build mode.
#
# EDF_MODE=custom -> the Yocto machine is generated from the PYNQ golden XSA
# (sdtgen + gen-machine-conf), so BOOT.BIN loads the PYNQ golden as the Versal
# segmented static/parent design. The runtime base overlay (base.pdi) is a
# segmented child of that same golden, so its parent image ID matches at load
# time. EDF_BOOT_MACHINE MUST NOT collide with an upstream machine name in
# meta-amd-adaptive-socs-bsp (e.g. versal-vck190-sdt-seg); otherwise bitbake
# resolves the upstream machine and ignores the golden-derived config. The
# pynq- prefix keeps the name unique.

EDF_MANIFEST_TAG=amd-edf-rel-v25.11.1
EDF_MODE=custom
EDF_BOOT_MACHINE=versal-vck190-pynq-seg
EDF_LINUX_MACHINE=amd-cortexa72-common
EDF_BOARD_DTS=versal-vck190-reva
BSP_XSA_PATH=golden/golden.xsa
